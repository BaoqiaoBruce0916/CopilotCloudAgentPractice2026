---
import Menu from '../assets/icons/menu.svg';
---

<header class="bg-blue-500 dark:bg-blue-700 text-white p-4 shadow-md transition-colors duration-300">
  <div class="container mx-auto flex justify-between items-center pl-4 pr-4">
    <div class="flex items-center">
      <div class="relative group">
        <button id="menu-toggle" class="focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-blue-500 rounded mr-4" aria-label="Toggle menu" aria-expanded="false" aria-controls="menu">
          <Menu class="h-6 w-6" aria-hidden="true" />
        </button>
        <nav id="menu" aria-label="Main" class="hidden absolute left-0 mt-2 w-48 bg-white dark:bg-slate-800 text-slate-800 dark:text-white rounded shadow-lg z-10 transition-colors duration-300">
          <ul class="py-1">
            <li><a href="/" class="block px-4 py-2 hover:bg-slate-100 dark:hover:bg-slate-700">Home</a></li>
            <li><a href="/about" class="block px-4 py-2 hover:bg-slate-100 dark:hover:bg-slate-700">About</a></li>
          </ul>
        </nav>
      </div>
      <div class="text-xl font-bold"><a href="/" class="hover:underline">Tailspin Toys</a></div>
    </div>
    <div role="group" aria-label="Display mode" class="flex items-center gap-1">
      <button
        id="mode-dark"
        type="button"
        class="px-3 py-1 rounded text-sm font-medium bg-white/20 hover:bg-white/30 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-blue-500 transition-colors duration-200"
        aria-pressed="true"
        data-testid="mode-dark"
      >
        Dark
      </button>
      <button
        id="mode-light"
        type="button"
        class="px-3 py-1 rounded text-sm font-medium bg-white/20 hover:bg-white/30 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-blue-500 transition-colors duration-200"
        aria-pressed="false"
        data-testid="mode-light"
      >
        Light
      </button>
      <button
        id="mode-high-contrast"
        type="button"
        class="px-3 py-1 rounded text-sm font-medium bg-white/20 hover:bg-white/30 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-blue-500 transition-colors duration-200"
        aria-pressed="false"
        data-testid="high-contrast-toggle"
      >
        High Contrast
      </button>
    </div>
  </div>
</header>

<script>
  // Toggle menu visibility when hamburger is clicked
  const menuToggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('menu');
  
  if (menuToggle && menu) {
    menuToggle.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      const isExpanded = !menu.classList.contains('hidden');
      menuToggle.setAttribute('aria-expanded', String(isExpanded));
      if (isExpanded) {
        const firstLink = menu.querySelector('a');
        if (firstLink) firstLink.focus();
      }
    });
    
    // Close menu when clicking outside
    document.addEventListener('click', (event) => {
      const target = event.target;
      const isClickInside = target instanceof Node && (menuToggle.contains(target) || menu.contains(target));
      if (!isClickInside && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
      }
    });

    // Close menu with Escape key and return focus to toggle button
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
        menu.classList.add('hidden');
        menuToggle.setAttribute('aria-enabled', 'false');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.focus();
      }
    });
  }

  // ── Display mode switcher ──────────────────────────────────────────────────
  type DisplayMode = 'dark' | 'light' | 'high-contrast';

  const htmlEl = document.documentElement;
  const btnDark = document.getElementById('mode-dark');
  const btnLight = document.getElementById('mode-light');
  const btnHC = document.getElementById('mode-high-contrast');

  function applyMode(mode: DisplayMode) {
    // Reset all mode classes
    htmlEl.classList.remove('dark', 'light', 'high-contrast');

    if (mode === 'dark') {
      htmlEl.classList.add('dark');
    } else if (mode === 'light') {
      htmlEl.classList.add('light');
    } else {
      htmlEl.classList.add('dark', 'high-contrast');
    }

    // Sync aria-pressed on all three buttons
    if (btnDark) btnDark.setAttribute('aria-pressed', String(mode === 'dark'));
    if (btnLight) btnLight.setAttribute('aria-pressed', String(mode === 'light'));
    if (btnHC) btnHC.setAttribute('aria-pressed', String(mode === 'high-contrast'));

    localStorage.setItem('display-mode', mode);
  }

  // Restore stored preference (the inline head script already set classes,
  // but we still need to sync aria-pressed on the buttons).
  const stored = (localStorage.getItem('display-mode') ?? 'dark') as DisplayMode;
  applyMode(stored);

  btnDark?.addEventListener('click', () => applyMode('dark'));
  btnLight?.addEventListener('click', () => applyMode('light'));
  btnHC?.addEventListener('click', () => applyMode('high-contrast'));
</script>